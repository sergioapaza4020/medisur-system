{
  "name": "medisur-system-frontend",
  "version": "0.0.1",
  "license": "Commercial",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "build:icons": "tsx src/assets/iconify-icons/bundle-icons-css.ts",
    "postinstall": "npm run build:icons",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest run --coverage --reporter=default --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "7.3.5",
    "@mui/lab": "7.0.1-beta.18",
    "@mui/material": "7.3.5",
    "@mui/material-nextjs": "7.3.5",
    "@mui/utils": "7.3.5",
    "apexcharts": "^4.5.1",
    "axios": "^1.15.1",
    "classnames": "^2.5.1",
    "js-cookie": "^3.0.8",
    "moment": "^2.30.1",
    "next": "16.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-apexcharts": "1.9.0",
    "react-perfect-scrollbar": "^1.5.8",
    "react-use": "^17.5.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.218",
    "@iconify/tools": "^4.0.4",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^2.1.24",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.0.4",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "postcss": "^8.4.38",
    "postcss-styled-syntax": "^0.6.4",
    "prettier": "^3.4.2",
    "stylelint": "^16.6.1",
    "stylelint-use-logical-spec": "^5.0.1",
    "tailwindcss": "^3.4.4",
    "tailwindcss-logical": "^3.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "react": "^18.3.1",
    "rimraf": "^5.0.7"
  }
