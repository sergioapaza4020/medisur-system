# Backend only. Neon branch-scoped Object Storage credentials, not DATABASE_URL.
STORAGE_PROVIDER=neon
STORAGE_BUCKET=public-read
# Bytes; default 5 MiB. Allowed configuration range: 1 byte to 50 MiB.
STORAGE_MAX_IMAGE_SIZE=5242880
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

